##
# Prod server configuration
#
server {
    include /etc/nginx/snippets/deny-repository-metadata.conf;
	listen [::]:443 ssl ipv6only=on http2; # managed by Certbot
        listen 443 ssl http2; # managed by Certbot
	server_name www.spinorama.org; # managed by Certbot
	access_log /var/log/nginx/spinorama-prod.access.log spinorama_bot;
	error_log /var/log/nginx/spinorama-prod.error.log warn;
    ssl_certificate /etc/letsencrypt/live/www.spinorama.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/www.spinorama.org/privkey.pem; # managed by Certbot
        include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
        ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

	root /var/www/html/spinorama-prod;
	autoindex off;
	index index.html;
	expires modified +1d;
	add_header Cache-Control "public, no-transform";

	include /etc/nginx/snippets/bot-protection-server.conf;
}
