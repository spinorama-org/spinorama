# Template for a new speaker: copy to datas/measurements/<Speaker>/meta.toml
# and fill in. Validate with:
#   generate-graph --metadata-dir datas/measurements --check-meta
name = ""
brand = ""
model = ""
type = "passive" # "passive" | "active"
price = ""
amount = "pair" # "pair" | "each"
shape = "bookshelves"
default_measurement = ""
# skip = true # uncomment while there is no measurement data yet

[measurements.asr]
origin = "ASR" # or "ErinsAudioCorner", "Princeton", "Vendors-<Brand>", ...
format = "klippel" # klippel | spl_hv_txt | gll_hv_txt | princeton | rew_text_dump | webplotdigitizer
quality = "high" # low | medium | high
review_published = "20221020"

[measurements.asr.reviews]
asr = "https://www.audiosciencereview.com/..."

[measurements.asr.data_acquisition]
via = "gll"
distance = 10
signal = "aes 20Hz-20kHz"
resolution = 5.0

[measurements.asr.specifications]
sensitivity = 87.0
impedance = 8.0
weight = 6.8

[measurements.asr.specifications.size]
height = 300
width = 200
depth = 250

[measurements.asr.specifications.SPL]
peak = 100.0

[measurements.asr.specifications.dispersion]
horizontal = 90.0
vertical = 60.0
