{
  "dependencies": {
    "@babel/core": "8.1.2",
    "bulma": "^1.0.4",
    "canvas": "^3.2.3",
    "fuse.js": "^7.5.0",
    "handlebars": "4.7.10",
    "npm": "12.2.2",
    "npm-check-updates": "23.1.1",
    "rollup": "^4.68.3",
    "tar": "^7.5.23"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "npm-check-updates": "23.1.1",
    "oxlint": "1.93.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "terser": "5.51.2",
    "vite": "8.3.8",
    "vitest": "^5.1.0",
    "w3c-html-validator": "2.2.3"
  },
  "scripts": {
    "local": "./scripts/generate_html.py --dev --sitedev=http://localhost:8888 --skip-speakers",
    "dev": "./scripts/generate_html.py --dev --optim --sitedev=https://dev.spinorama.org",
    "build": "./scripts/generate_html.py --optim",
    "test": "npx vitest",
    "coverage": "npx vitest run --coverage",
    "format": "npx prettier --write \"src/website/*.js\"",
    "upgrade": "npx npm-check-updates -u",
    "lint": "oxlint",
    "test:dev": "vitest run --config vitest.dev.config.mjs"
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "@parcel/watcher@2.6.0": true
  }
}
